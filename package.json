{
  "name": "shenlun-answer-sheet",
  "private": true,
  "version": "1.0.0",
  "description": "公务员考试申论电脑模拟答题卡 —— 在网页上还原标准答题卡（单题 A4 纵向 / 整卷 A3 横向），键盘输入自动按申论方格纸规则排版",
  "license": "MIT",
  "keywords": [
    "申论",
    "公务员考试",
    "答题卡",
    "方格纸",
    "公考",
    "排版引擎",
    "shenlun",
    "typescript",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Murphy3569/shenlun-answer-sheet.git"
  },
  "homepage": "https://murphy3569.github.io/shenlun-answer-sheet/",
  "bugs": {
    "url": "https://github.com/Murphy3569/shenlun-answer-sheet/issues"
  },
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run build",
    "build:singlefile": "vite build --config vite.config.singlefile.ts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "docx": "^9.5.1",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.1",
    "jszip": "^3.10.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.8"
  }
}
